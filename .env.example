# Database configuration
DATABASE_URL=sqlite:///./campaigns.db

# Admin auth (set this before running the app)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Groq AI
GROQ_API_KEY=your_groq_key_here

# Google Apps Script bridge
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycbyDlI2n4MgsyEIQTa5TfVgBDcUgM0DXF6VaPOizJrxOfd2wJuc7QNxy4fQp3HXyyen_/exec

# SMTP (for the optional automated email sender)
SMTP_EMAIL=your-email@gmail.com
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_RECEIVER_EMAIL=recipient@example.com
